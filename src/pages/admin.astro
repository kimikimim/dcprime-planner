---
import '../styles/global.css';
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>플래너 관리자</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" href="/favicon-circle.png" />
  </head>
  <body class="admin-body">
    <!-- 로그인은 `/`에서 PIN으로 통합 (여기 직접 들어오면 세션 없을 때 `/`로 리다이렉트) -->
    <header class="admin-header">
      <div class="admin-header-inner">
        <div class="admin-header-left">
          <img src="/favicon-circle.png" alt="대치프라임" style="width:34px;height:34px;border-radius:50%;object-fit:cover" />
          <span class="admin-title-text">플래너 관리자</span>
        </div>
        <div class="admin-header-right">
          <button class="hamburger-btn" id="hamburger-btn" title="메뉴">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
          </button>
          <button class="icon-btn" id="logout-btn" title="로그아웃">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>
        </div>
      </div>

      <div class="tab-bar">
        <button class="tab-btn active" data-tab="students">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2M9 11a4 4 0 100-8 4 4 0 000 8zM23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
          학생 관리
        </button>
        <button class="tab-btn" data-tab="study-overview">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M2 3h6a4 4 0 014 4v14a3 3 0 00-3-3H2zM22 3h-6a4 4 0 00-4 4v14a3 3 0 013-3h7z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
          학습 현황
        </button>
        <button class="tab-bar-logout" id="hamburger-logout-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
          로그아웃
        </button>
      </div>
    </header>

    <!-- 학생 관리 -->
    <div class="tab-panel active" id="tab-students">
      <div class="admin-panel">
        <div class="panel-toolbar">
          <h2 class="section-subtitle" style="margin:0">학생 목록</h2>
          <button type="button" class="btn-primary-sm" id="add-student-btn">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="white" stroke-width="2.5" stroke-linecap="round" /></svg>
            학생 추가
          </button>
        </div>
        <div class="student-mgmt-list" id="student-mgmt-list">
          <p class="empty-text">불러오는 중...</p>
        </div>
      </div>
    </div>

    <!-- 학습 현황 -->
    <div class="tab-panel" id="tab-study-overview">
      <div class="admin-panel">
        <div class="panel-toolbar">
          <h2 class="section-subtitle" style="margin:0">오늘 학습 현황</h2>
        </div>
        <div class="student-summary-cards" id="study-summary-cards">
          <p class="empty-text">불러오는 중...</p>
        </div>
        <h3 class="section-subtitle">최근 기록 (전체 학생)</h3>
        <div class="study-log-list" id="admin-study-log-list">
          <p class="empty-text">불러오는 중...</p>
        </div>
      </div>
    </div>

    <!-- 학생 추가/수정 모달 -->
    <div class="modal-overlay" id="student-modal">
      <div class="modal modal--form">
        <h3 class="modal-title" id="student-modal-title">학생 추가</h3>

        <div class="form-group">
          <label class="form-label">이름 <span class="form-required">*</span></label>
          <input class="form-input" id="field-name" type="text" placeholder="홍길동" maxlength="20" />
        </div>
        <div class="form-group">
          <label class="form-label">PIN (4자리) <span class="form-required">*</span></label>
          <input class="form-input" id="field-pin" type="text" placeholder="0000" maxlength="4" pattern="\d{4}" inputmode="numeric" />
        </div>
        <div class="form-group">
          <label class="form-label">학교</label>
          <input class="form-input" id="field-school" type="text" placeholder="○○고등학교" maxlength="30" />
        </div>
        <div class="form-group">
          <label class="form-label">학년</label>
          <input class="form-input" id="field-grade" type="text" placeholder="고2, 고3" maxlength="10" />
        </div>

        <p class="form-error" id="student-form-error"></p>

        <div class="modal-actions">
          <button type="button" class="modal-btn modal-btn--cancel" id="student-modal-cancel">취소</button>
          <button type="button" class="modal-btn modal-btn--save" id="student-modal-save">저장</button>
        </div>
      </div>
    </div>

    <!-- 학생 삭제 확인 모달 -->
    <div class="modal-overlay" id="delete-student-modal">
      <div class="modal">
        <h3 class="modal-title">학생을 삭제할까요?</h3>
        <p class="modal-desc">삭제하면 이 학생의 할일·시간표·학습기록·목표가 모두 함께 삭제됩니다.</p>
        <div class="modal-actions">
          <button type="button" class="modal-btn modal-btn--cancel" id="delete-cancel">취소</button>
          <button type="button" class="modal-btn modal-btn--confirm" id="delete-confirm">삭제</button>
        </div>
      </div>
    </div>

    <script>
      import { planner } from '../lib/supabase';

      const SESSION_KEY = 'dcprime_planner_admin_session';

      function escHtml(str: string) {
        return String(str ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
      }

      function pad2(n: number) {
        return String(n).padStart(2, '0');
      }

      function ymdLocal(d: Date) {
        return `${d.getFullYear()}-${pad2(d.getMonth() + 1)}-${pad2(d.getDate())}`;
      }

      // 학습시간의 "오늘"은 학생 페이지와 동일하게 새벽 4시 기준으로 넘어감
      function studyDayStr() {
        const d = new Date();
        d.setHours(d.getHours() - 4);
        return ymdLocal(d);
      }

      document.getElementById('logout-btn')?.addEventListener('click', () => {
        sessionStorage.removeItem(SESSION_KEY);
        location.replace('/');
      });
      document.getElementById('hamburger-logout-btn')?.addEventListener('click', () => {
        document.getElementById('logout-btn')?.click();
      });

      // ── 탭 전환 + 모바일 드로어 메뉴 ──
      const tabBtns = document.querySelectorAll<HTMLElement>('.tab-btn');
      const panels: Record<string, HTMLElement> = {
        students: document.getElementById('tab-students')!,
        'study-overview': document.getElementById('tab-study-overview')!,
      };
      const tabBar = document.querySelector('.tab-bar')!;
      const menuBackdrop = document.createElement('div');
      menuBackdrop.className = 'menu-backdrop';
      document.body.appendChild(menuBackdrop);
      const closeMenu = () => {
        tabBar.classList.remove('open');
        menuBackdrop.classList.remove('show');
      };
      const openMenu = () => {
        tabBar.classList.add('open');
        menuBackdrop.classList.add('show');
      };

      tabBtns.forEach((b) =>
        b.addEventListener('click', () => {
          const t = b.dataset.tab!;
          tabBtns.forEach((x) => x.classList.toggle('active', x.dataset.tab === t));
          Object.entries(panels).forEach(([k, p]) => p.classList.toggle('active', k === t));
          closeMenu();
          if (t === 'students') loadStudents();
          if (t === 'study-overview') loadStudyOverview();
        })
      );
      document.getElementById('hamburger-btn')?.addEventListener('click', (e) => {
        e.stopPropagation();
        tabBar.classList.contains('open') ? closeMenu() : openMenu();
      });
      menuBackdrop.addEventListener('click', closeMenu);

      // ── 학생 목록 ──
      let studentsCache: any[] = [];

      async function loadStudents() {
        const { data } = await planner.from('students').select('*').order('created_at', { ascending: false });
        studentsCache = data ?? [];
        const el = document.getElementById('student-mgmt-list')!;
        if (studentsCache.length === 0) {
          el.innerHTML = '<p class="empty-text">등록된 학생이 없어요.</p>';
          return;
        }
        el.innerHTML = studentsCache
          .map(
            (s) => `
          <div class="student-mgmt-card">
            <div class="student-mgmt-avatar">${escHtml((s.name || '?').slice(0, 1))}</div>
            <div class="student-mgmt-info">
              <p class="student-mgmt-name">${escHtml(s.name)}</p>
              <p class="student-mgmt-meta">${[s.school, s.grade].filter(Boolean).map(escHtml).join(' · ') || '&nbsp;'} · PIN ${escHtml(s.pin)} · ${s.is_active ? '활성' : '비활성'}</p>
            </div>
            <div class="student-mgmt-actions">
              <button type="button" class="btn-edit" data-id="${s.id}">수정</button>
              <button type="button" class="btn-delete" data-id="${s.id}">삭제</button>
            </div>
          </div>`
          )
          .join('');
      }

      // ── 추가/수정 모달 ──
      const studentModal = document.getElementById('student-modal')!;
      const studentModalTitle = document.getElementById('student-modal-title')!;
      const studentFormError = document.getElementById('student-form-error')!;
      const fieldName = document.getElementById('field-name') as HTMLInputElement;
      const fieldPin = document.getElementById('field-pin') as HTMLInputElement;
      const fieldSchool = document.getElementById('field-school') as HTMLInputElement;
      const fieldGrade = document.getElementById('field-grade') as HTMLInputElement;
      let editingId: string | null = null;

      function openStudentModal(student?: any) {
        editingId = student?.id ?? null;
        studentModalTitle.textContent = student ? '학생 정보 수정' : '학생 추가';
        fieldName.value = student?.name ?? '';
        fieldPin.value = student?.pin ?? '';
        fieldSchool.value = student?.school ?? '';
        fieldGrade.value = student?.grade ?? '';
        studentFormError.textContent = '';
        studentModal.classList.add('show');
      }

      function closeStudentModal() {
        studentModal.classList.remove('show');
      }

      document.getElementById('add-student-btn')?.addEventListener('click', () => openStudentModal());
      document.getElementById('student-modal-cancel')?.addEventListener('click', closeStudentModal);

      document.getElementById('student-modal-save')?.addEventListener('click', async () => {
        const name = fieldName.value.trim();
        const pinVal = fieldPin.value.trim();
        if (!name) {
          studentFormError.textContent = '이름을 입력해주세요.';
          return;
        }
        if (!/^\d{4}$/.test(pinVal)) {
          studentFormError.textContent = 'PIN은 숫자 4자리여야 합니다.';
          return;
        }
        const payload = {
          name,
          pin: pinVal,
          school: fieldSchool.value.trim() || null,
          grade: fieldGrade.value.trim() || null,
        };
        const { error } = editingId
          ? await planner.from('students').update(payload).eq('id', editingId)
          : await planner.from('students').insert(payload);
        if (error) {
          studentFormError.textContent = error.message.includes('duplicate') ? '이미 사용 중인 PIN입니다.' : error.message;
          return;
        }
        closeStudentModal();
        loadStudents();
      });

      // ── 삭제 모달 ──
      const deleteModal = document.getElementById('delete-student-modal')!;
      let deletingId: string | null = null;

      document.getElementById('delete-cancel')?.addEventListener('click', () => deleteModal.classList.remove('show'));
      document.getElementById('delete-confirm')?.addEventListener('click', async () => {
        if (!deletingId) return;
        await planner.from('students').delete().eq('id', deletingId);
        deleteModal.classList.remove('show');
        loadStudents();
      });

      document.getElementById('student-mgmt-list')?.addEventListener('click', (e) => {
        const target = (e.target as HTMLElement).closest('button') as HTMLElement | null;
        if (!target) return;
        const id = target.dataset.id;
        if (target.classList.contains('btn-edit')) {
          openStudentModal(studentsCache.find((s) => s.id === id));
        }
        if (target.classList.contains('btn-delete')) {
          deletingId = id ?? null;
          deleteModal.classList.add('show');
        }
      });

      // ── 학습 현황 (dcprime.10 admin.html 학습 현황 탭 이식) ──
      async function loadStudyOverview() {
        const cardsEl = document.getElementById('study-summary-cards')!;
        const listEl = document.getElementById('admin-study-log-list')!;
        cardsEl.innerHTML = '<p class="empty-text">불러오는 중...</p>';
        listEl.innerHTML = '<p class="empty-text">불러오는 중...</p>';

        const [{ data: students }, { data: todayLogs }, { data: recent }] = await Promise.all([
          planner.from('students').select('*').eq('is_active', true).order('name'),
          planner.from('study_logs').select('*').eq('log_date', studyDayStr()),
          planner.from('study_logs').select('*, students(name)').order('log_date', { ascending: false }).order('created_at', { ascending: false }).limit(20),
        ]);

        const byStudent = new Map<string, any[]>();
        (todayLogs ?? []).forEach((l: any) => {
          if (!byStudent.has(l.student_id)) byStudent.set(l.student_id, []);
          byStudent.get(l.student_id)!.push(l);
        });

        cardsEl.innerHTML = (students ?? []).length
          ? students!
              .map((s: any) => {
                const logs = byStudent.get(s.id) ?? [];
                const total = logs.reduce((sum: number, l: any) => sum + l.minutes, 0);
                const bySubject: Record<string, number> = {};
                logs.forEach((l: any) => {
                  const k = l.subject || '기타';
                  bySubject[k] = (bySubject[k] ?? 0) + l.minutes;
                });
                const badges = Object.entries(bySubject)
                  .map(([k, m]) => `<span class="subject-badge" style="background:var(--blue-light);color:var(--blue)">${escHtml(k)} ${m}분</span>`)
                  .join('');
                return `
              <div class="summary-card">
                <div class="summary-card-top">
                  <div class="summary-avatar">${escHtml((s.name || '?').slice(0, 1))}</div>
                  <div>
                    <p class="summary-name">${escHtml(s.name)}</p>
                    <p class="summary-grade">${escHtml(s.grade ?? '')}</p>
                  </div>
                  <span class="summary-total">${total}분</span>
                </div>
                <div class="summary-subjects">${badges || '<span class="empty-text" style="padding:0">오늘 기록 없음</span>'}</div>
              </div>`;
              })
              .join('')
          : '<p class="empty-text">등록된 학생이 없어요.</p>';

        listEl.innerHTML = (recent ?? []).length
          ? recent!
              .map(
                (l: any) => `
            <div class="study-log-item">
              <div class="study-log-info">
                <div class="study-log-top">
                  <span class="study-log-student">${escHtml(l.students?.name ?? '알 수 없음')}</span>
                  <span class="subject-badge" style="background:var(--blue-light);color:var(--blue)">${escHtml(l.subject || '기타')}</span>
                  <span class="study-log-hours">${l.minutes}분</span>
                </div>
                ${l.memo ? `<p class="study-log-summary">${escHtml(l.memo)}</p>` : ''}
                <p class="study-log-date">${l.log_date}</p>
              </div>
            </div>`
              )
              .join('')
          : '<p class="empty-text">기록이 없어요.</p>';
      }

      if (sessionStorage.getItem(SESSION_KEY) === 'ok') {
        loadStudents();
      } else {
        location.replace('/');
      }
    </script>
  </body>
</html>
