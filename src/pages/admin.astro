---
import '../styles/global.css';
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>플래너 관리자</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="min-h-screen bg-brand-light font-sans text-slate-800">
    <!-- 로그인 -->
    <div id="login-screen" class="flex min-h-screen items-center justify-center px-4">
      <div class="w-full max-w-sm rounded-2xl bg-white p-8 shadow-lg">
        <h1 class="mb-6 text-center text-xl font-bold text-brand-dark">플래너 관리자</h1>
        <input
          id="admin-pw"
          type="password"
          placeholder="비밀번호"
          class="mb-3 w-full rounded-lg border border-slate-300 px-4 py-3 focus:border-brand focus:outline-none"
        />
        <p id="login-error" class="mb-3 hidden text-center text-sm text-red-500">비밀번호가 올바르지 않습니다.</p>
        <button id="login-btn" class="w-full rounded-lg bg-brand py-3 font-semibold text-white hover:bg-brand-dark">로그인</button>
      </div>
    </div>

    <!-- 관리 화면 -->
    <div id="admin-panel" class="hidden min-h-screen">
      <header class="flex items-center justify-between bg-white px-6 py-4 shadow-sm">
        <h1 class="font-bold text-brand-dark">플래너 학생 관리</h1>
        <button id="logout-btn" class="text-sm text-slate-400 underline">로그아웃</button>
      </header>

      <main class="mx-auto max-w-4xl px-4 py-6">
        <form id="student-form" class="mb-6 grid grid-cols-2 gap-2 rounded-xl bg-white p-4 shadow-sm sm:grid-cols-5">
          <input type="text" id="s-name" placeholder="이름" required class="rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand focus:outline-none" />
          <input type="text" id="s-school" placeholder="학교" class="rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand focus:outline-none" />
          <input type="text" id="s-grade" placeholder="학년 (고2/고3)" class="rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand focus:outline-none" />
          <input type="text" id="s-pin" placeholder="PIN (4자리)" inputmode="numeric" maxlength="4" required class="rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-brand focus:outline-none" />
          <button type="submit" class="rounded-lg bg-brand py-2 text-sm font-semibold text-white">학생 추가</button>
        </form>
        <p id="form-error" class="mb-4 hidden text-sm text-red-500"></p>

        <div class="overflow-x-auto rounded-xl bg-white shadow-sm">
          <table class="w-full text-left text-sm">
            <thead class="border-b border-slate-200 text-slate-400">
              <tr>
                <th class="px-4 py-3">이름</th>
                <th class="px-4 py-3">학교</th>
                <th class="px-4 py-3">학년</th>
                <th class="px-4 py-3">PIN</th>
                <th class="px-4 py-3">활성</th>
                <th class="px-4 py-3">등록일</th>
                <th class="px-4 py-3"></th>
              </tr>
            </thead>
            <tbody id="student-tbody"></tbody>
          </table>
        </div>
      </main>
    </div>

    <script>
      import { planner } from '../lib/supabase';

      const SESSION_KEY = 'dcprime_planner_admin_session';

      function isLoggedIn() {
        return sessionStorage.getItem(SESSION_KEY) === 'ok';
      }

      function showPanel() {
        document.getElementById('login-screen')!.classList.add('hidden');
        document.getElementById('admin-panel')!.classList.remove('hidden');
        loadStudents();
      }

      function showLogin() {
        document.getElementById('login-screen')!.classList.remove('hidden');
        document.getElementById('admin-panel')!.classList.add('hidden');
      }

      function escHtml(str: string) {
        return String(str ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
      }

      document.getElementById('login-btn')?.addEventListener('click', async () => {
        const btn = document.getElementById('login-btn') as HTMLButtonElement;
        const pw = (document.getElementById('admin-pw') as HTMLInputElement).value;
        btn.disabled = true;
        btn.textContent = '확인 중...';
        const { data, error } = await planner.rpc('verify_admin_password', { pw });
        btn.disabled = false;
        btn.textContent = '로그인';
        if (!error && data === true) {
          sessionStorage.setItem(SESSION_KEY, 'ok');
          document.getElementById('login-error')!.classList.add('hidden');
          showPanel();
        } else {
          document.getElementById('login-error')!.classList.remove('hidden');
        }
      });

      document.getElementById('admin-pw')?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') (document.getElementById('login-btn') as HTMLButtonElement).click();
      });

      document.getElementById('logout-btn')?.addEventListener('click', () => {
        sessionStorage.removeItem(SESSION_KEY);
        showLogin();
      });

      async function loadStudents() {
        const { data, error } = await planner.from('students').select('*').order('created_at', { ascending: false });
        const tbody = document.getElementById('student-tbody')!;
        if (error || !data || data.length === 0) {
          tbody.innerHTML = '<tr><td colspan="7" class="px-4 py-6 text-center text-slate-400">등록된 학생이 없어요.</td></tr>';
          return;
        }
        tbody.innerHTML = data
          .map(
            (s: any) => `
          <tr class="border-b border-slate-100 last:border-0">
            <td class="px-4 py-3">${escHtml(s.name)}</td>
            <td class="px-4 py-3">${escHtml(s.school ?? '')}</td>
            <td class="px-4 py-3">${escHtml(s.grade ?? '')}</td>
            <td class="px-4 py-3 font-mono">${escHtml(s.pin)}</td>
            <td class="px-4 py-3">
              <button data-id="${s.id}" data-active="${s.is_active}" class="toggle-active rounded-full px-2 py-1 text-xs font-semibold ${s.is_active ? 'bg-brand-light text-brand-dark' : 'bg-slate-100 text-slate-400'}">
                ${s.is_active ? '활성' : '비활성'}
              </button>
            </td>
            <td class="px-4 py-3 text-slate-400">${String(s.created_at).slice(0, 10)}</td>
            <td class="px-4 py-3 text-right">
              <button data-id="${s.id}" class="delete-student text-xs text-slate-300 hover:text-red-400">삭제</button>
            </td>
          </tr>`
          )
          .join('');
      }

      document.getElementById('student-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const nameEl = document.getElementById('s-name') as HTMLInputElement;
        const schoolEl = document.getElementById('s-school') as HTMLInputElement;
        const gradeEl = document.getElementById('s-grade') as HTMLInputElement;
        const pinEl = document.getElementById('s-pin') as HTMLInputElement;
        const errorEl = document.getElementById('form-error')!;

        if (!/^\d{4}$/.test(pinEl.value.trim())) {
          errorEl.textContent = 'PIN은 숫자 4자리여야 합니다.';
          errorEl.classList.remove('hidden');
          return;
        }

        const { error } = await planner.from('students').insert({
          name: nameEl.value.trim(),
          school: schoolEl.value.trim() || null,
          grade: gradeEl.value.trim() || null,
          pin: pinEl.value.trim(),
        });

        if (error) {
          errorEl.textContent = error.message.includes('duplicate') ? '이미 사용 중인 PIN입니다.' : error.message;
          errorEl.classList.remove('hidden');
          return;
        }

        errorEl.classList.add('hidden');
        (document.getElementById('student-form') as HTMLFormElement).reset();
        loadStudents();
      });

      document.getElementById('student-tbody')?.addEventListener('click', async (e) => {
        const target = e.target as HTMLElement;
        if (target.classList.contains('delete-student')) {
          const id = target.dataset.id!;
          if (!confirm('이 학생을 삭제할까요? 관련 할일/학습기록/목표가 모두 함께 삭제됩니다.')) return;
          await planner.from('students').delete().eq('id', id);
          loadStudents();
        }
        if (target.classList.contains('toggle-active')) {
          const id = target.dataset.id!;
          const current = target.dataset.active === 'true';
          await planner.from('students').update({ is_active: !current }).eq('id', id);
          loadStudents();
        }
      });

      if (isLoggedIn()) showPanel();
    </script>
  </body>
</html>
