---
import '../styles/global.css';
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>대치프라임 플래너</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" href="/favicon-circle.png" />
    <style is:global>
      /* 이 페이지 전용 컴포넌트 — dcprime.10(텐투텐) chat.html의 인라인 스타일을 그대로 이식.
         클라이언트 JS가 innerHTML로 그려서 Astro 스코프드 CSS 대상이 아니므로 is:global 필요. */

      /* ── 할일 (dcprime.10 "오늘의 목표" .gl-* 그대로) ── */
      .gl-progress { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
      .gl-bar { flex: 1; height: 10px; background: var(--gray-7); border-radius: 999px; overflow: hidden; }
      .gl-bar-fill { height: 100%; width: 0; background: var(--blue); border-radius: 999px; transition: width .25s; }
      .gl-rate { font-size: 13px; font-weight: 800; color: var(--blue); min-width: 38px; text-align: right; }
      .gl-add { display: flex; gap: 8px; margin-bottom: 12px; }
      .gl-subject { flex: 0 0 76px; }
      .gl-input { flex: 1; min-width: 0; border: 1.5px solid var(--gray-6); border-radius: 10px; padding: 11px 12px; font-size: 14px; background: var(--gray-8); outline: none; }
      .gl-input:focus { border-color: var(--blue); background: var(--white); }
      .gl-add-btn { background: var(--blue); color: #fff; border: none; border-radius: 10px; padding: 0 16px; font-size: 14px; font-weight: 700; }
      .gl-item { display: flex; align-items: center; gap: 10px; background: var(--white); border: 1px solid var(--gray-6); border-radius: var(--r-md); padding: 12px 14px; margin-bottom: 8px; }
      .gl-check { width: 22px; height: 22px; border-radius: 7px; border: 2px solid var(--gray-5); flex-shrink: 0; cursor: pointer; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 13px; }
      .gl-check.done { background: var(--green); border-color: var(--green); }
      .gl-text { flex: 1; font-size: 14px; color: var(--black); }
      .gl-text.done { text-decoration: line-through; color: var(--gray-4); }
      .gl-del { border: none; background: none; color: var(--red); font-weight: 600; cursor: pointer; font-size: 12px; }

      /* ── 시간표 (dcprime.10 "일일 스케쥴" .tt-* 그대로, 색상만 디자인 시스템 변수로) ── */
      .tt-datebar { text-align: center; margin-bottom: 14px; }
      .tt-date { font-size: 16px; font-weight: 700; color: var(--black); }
      .tt-submit { width: 100%; margin-top: 4px; background: var(--blue); color: #fff; border: none; border-radius: var(--r-md); padding: 14px; font-size: 15px; font-weight: 700; cursor: pointer; }
      .tt-submit.done { background: var(--green); }
      .tt-legend { display: flex; flex-wrap: wrap; gap: 7px; justify-content: center; margin-bottom: 16px; }
      .tt-sub { display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; border-radius: 999px; font-size: 13px; font-weight: 600; cursor: pointer; border: 2px solid transparent; background: var(--gray-7); color: var(--gray-2); transition: all .12s; }
      .tt-sub .dot { width: 12px; height: 12px; border-radius: 50%; }
      .tt-sub.sel { border-color: var(--black); }
      .tt-grid { border: 1px solid var(--gray-6); border-radius: var(--r-md); overflow: hidden; }
      .tt-row { display: grid; grid-template-columns: 60px 1fr; align-items: stretch; border-bottom: 1px solid var(--gray-7); }
      .tt-row:last-child { border-bottom: none; }
      .tt-time { font-size: 12px; color: var(--gray-3); padding: 0 8px; display: flex; align-items: center; justify-content: flex-end; background: var(--gray-8); }
      .tt-cell { min-height: 30px; cursor: pointer; display: flex; align-items: center; padding-left: 12px; font-size: 12.5px; font-weight: 600; color: #fff; transition: background .1s; }
      .tt-cell.empty { background: var(--white); color: transparent; }
      .tt-cell.empty:hover { background: var(--gray-8); }
      .tt-summary { display: flex; flex-wrap: wrap; gap: 8px; margin: 16px 0; justify-content: center; }
      .tt-stat { font-size: 13px; color: var(--gray-2); background: var(--gray-7); border-radius: 8px; padding: 6px 12px; }
      .tt-stat b { color: var(--black); }
      .tt-hint { text-align: center; font-size: 12px; color: var(--gray-4); margin-top: 14px; }

      /* ── 학습시간 (dcprime.10 .study-log-item 계열, 사진 없는 버전) ── */
      .study-log-list { background: var(--white); border-radius: var(--r-md); padding: 4px 16px; box-shadow: var(--shadow-sm); }
      .study-log-item { display: flex; align-items: center; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--gray-7); }
      .study-log-item:last-child { border-bottom: none; }
      .study-log-info { flex: 1; min-width: 0; }
      .study-log-top { display: flex; align-items: center; gap: 6px; margin-bottom: 2px; flex-wrap: wrap; }
      .study-log-hours { font-size: 13px; font-weight: 700; color: var(--blue); margin-left: auto; }
      .study-log-summary { font-size: 12px; color: var(--gray-2); }
      .study-log-date { font-size: 11px; color: var(--gray-4); }

      /* ── 목표 / D-Day ── */
      .dday-card { display: flex; align-items: center; gap: 12px; background: var(--white); border-radius: var(--r-md); padding: 14px 16px; margin-bottom: 8px; box-shadow: var(--shadow-sm); }
      .dday-badge { flex-shrink: 0; background: var(--blue); color: #fff; font-size: 12px; font-weight: 800; border-radius: 8px; padding: 6px 10px; }
      .dday-title { font-size: 14px; font-weight: 700; color: var(--black); }
      .dday-meta { font-size: 11px; color: var(--gray-4); margin-top: 2px; }
    </style>
  </head>
  <body>
    <!-- 로그인 화면 -->
    <div class="login-body" id="login-screen">
      <div class="login-container">
        <div class="login-logo">
          <img src="/favicon-circle.png" alt="대치프라임" style="width:56px;height:56px;border-radius:50%;object-fit:cover" />
          <span class="logo-text">DC Prime 플래너</span>
        </div>
        <div class="login-header">
          <h1 class="login-title">PIN 번호를<br />입력하세요</h1>
          <p class="login-subtitle">4자리 번호를 눌러주세요</p>
        </div>
        <div class="pin-display" id="pin-display">
          <div class="pin-dot" id="dot0"></div>
          <div class="pin-dot" id="dot1"></div>
          <div class="pin-dot" id="dot2"></div>
          <div class="pin-dot" id="dot3"></div>
        </div>
        <p class="error-message" id="login-error"></p>
        <div class="numpad">
          <button type="button" class="numpad-btn" data-num="1">1</button>
          <button type="button" class="numpad-btn" data-num="2">2<span class="numpad-sub">ABC</span></button>
          <button type="button" class="numpad-btn" data-num="3">3<span class="numpad-sub">DEF</span></button>
          <button type="button" class="numpad-btn" data-num="4">4<span class="numpad-sub">GHI</span></button>
          <button type="button" class="numpad-btn" data-num="5">5<span class="numpad-sub">JKL</span></button>
          <button type="button" class="numpad-btn" data-num="6">6<span class="numpad-sub">MNO</span></button>
          <button type="button" class="numpad-btn" data-num="7">7<span class="numpad-sub">PQRS</span></button>
          <button type="button" class="numpad-btn" data-num="8">8<span class="numpad-sub">TUV</span></button>
          <button type="button" class="numpad-btn" data-num="9">9<span class="numpad-sub">WXYZ</span></button>
          <div class="numpad-empty"></div>
          <button type="button" class="numpad-btn" data-num="0">0</button>
          <button type="button" class="numpad-btn numpad-del" id="delete-btn" aria-label="지우기">
            <svg width="22" height="16" viewBox="0 0 22 16" fill="none">
              <path d="M8 1H20C20.5523 1 21 1.44772 21 2V14C21 14.5523 20.5523 15 20 15H8L1 8L8 1Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
              <path d="M13 6L17 10M17 6L13 10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
            </svg>
          </button>
        </div>
        <div class="login-loading" id="login-loading">
          <div class="loading-spinner"></div>
          <span>확인 중...</span>
        </div>
      </div>
    </div>

    <!-- 메인 화면 -->
    <div id="app-screen" class="chat-body hidden">
      <header class="chat-header">
        <div class="chat-header-inner">
          <div class="chat-header-left">
            <img src="/favicon-circle.png" alt="대치프라임" style="width:34px;height:34px;border-radius:50%;object-fit:cover" />
            <div>
              <p class="chat-header-name"><span id="student-name"></span>님</p>
              <p class="chat-header-grade" id="student-grade"></p>
            </div>
          </div>
          <div class="chat-header-right">
            <button class="hamburger-btn" id="hamburger-btn" title="메뉴">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
            </button>
            <button class="icon-btn" id="logout-btn" title="로그아웃">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </button>
          </div>
        </div>

        <div class="tab-bar">
          <button class="tab-btn active" data-tab="todos">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M9 11l3 3 8-8M20 12v6a2 2 0 01-2 2H6a2 2 0 01-2-2V6a2 2 0 012-2h9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            할일
          </button>
          <button class="tab-btn" data-tab="timetable">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><rect x="3" y="4" width="18" height="17" rx="2" stroke="currentColor" stroke-width="2" /><path d="M3 9h18M8 2v4M16 2v4" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
            시간표
          </button>
          <button class="tab-btn" data-tab="study">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M2 3h6a4 4 0 014 4v14a3 3 0 00-3-3H2zM22 3h-6a4 4 0 00-4 4v14a3 3 0 013-3h7z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            학습시간
          </button>
          <button class="tab-btn" data-tab="goals">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2" /><circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="2" /><circle cx="12" cy="12" r="1.5" fill="currentColor" /></svg>
            목표
          </button>
          <button class="tab-bar-logout" id="hamburger-logout-btn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
            로그아웃
          </button>
        </div>
      </header>

      <!-- 할일 -->
      <div class="tab-panel active" id="tab-todos">
        <div class="study-container">
          <div>
            <h2 class="study-section-title">오늘 할일</h2>
            <div class="gl-progress">
              <div class="gl-bar"><div class="gl-bar-fill" id="daily-progress-fill"></div></div>
              <span class="gl-rate" id="daily-progress-rate">0%</span>
            </div>
            <form id="daily-todo-form" class="gl-add">
              <input type="text" id="daily-todo-subject" placeholder="과목" list="subject-list" class="gl-input gl-subject" />
              <input type="text" id="daily-todo-content" placeholder="할 일을 입력하세요" required maxlength="100" class="gl-input" />
              <button type="submit" class="gl-add-btn">추가</button>
            </form>
            <div id="daily-todo-list"><p class="empty-text">아직 등록된 항목이 없어요.</p></div>
          </div>

          <div>
            <h2 class="study-section-title">이번주 할일</h2>
            <div class="gl-progress">
              <div class="gl-bar"><div class="gl-bar-fill" id="weekly-progress-fill"></div></div>
              <span class="gl-rate" id="weekly-progress-rate">0%</span>
            </div>
            <form id="weekly-todo-form" class="gl-add">
              <input type="text" id="weekly-todo-subject" placeholder="과목" list="subject-list" class="gl-input gl-subject" />
              <input type="text" id="weekly-todo-content" placeholder="이번주 목표를 입력하세요" required maxlength="100" class="gl-input" />
              <button type="submit" class="gl-add-btn">추가</button>
            </form>
            <div id="weekly-todo-list"><p class="empty-text">아직 등록된 항목이 없어요.</p></div>
          </div>
        </div>
      </div>

      <!-- 시간표 -->
      <div class="tab-panel" id="tab-timetable">
        <div class="tt-wrap" style="max-width:560px;margin:0 auto;padding:20px 16px 40px;width:100%">
          <div class="tt-datebar">
            <div class="tt-date" id="tt-date">날짜</div>
          </div>
          <div class="tt-legend" id="tt-legend"></div>
          <div class="tt-grid" id="tt-grid"></div>
          <div class="tt-summary" id="tt-summary"></div>
          <button type="button" class="tt-submit" id="tt-submit">오늘 시간표 제출</button>
          <p class="tt-hint">시간 칸을 누르면 선택한 항목으로 칠해집니다. 빈칸 = 기록 없는 시간. (지우개로 비우기)</p>
        </div>
      </div>

      <!-- 학습시간 -->
      <div class="tab-panel" id="tab-study">
        <div class="study-container">
          <div class="study-form-card">
            <div>
              <h2 class="study-section-title">학습시간 기록</h2>
              <p class="study-section-desc">오늘 공부한 내용을 기록해두세요.</p>
            </div>
            <form id="study-log-form" style="display:flex;flex-direction:column;gap:12px">
              <div class="study-field">
                <label class="study-label">날짜</label>
                <input type="date" id="study-log-date" required class="form-input" />
              </div>
              <div class="study-field">
                <label class="study-label">과목</label>
                <input type="text" id="study-log-subject" placeholder="과목" list="subject-list" required class="form-input" />
              </div>
              <div class="study-field">
                <label class="study-label">학습 시간(분)</label>
                <input type="number" id="study-log-minutes" placeholder="예: 90" min="1" required class="form-input" />
              </div>
              <div class="study-field">
                <label class="study-label">메모 <span class="study-label-hint">선택</span></label>
                <input type="text" id="study-log-memo" placeholder="메모 (선택)" class="form-input" />
              </div>
              <button type="submit" class="btn-primary btn-full">기록하기</button>
            </form>
          </div>

          <div>
            <h3 class="section-subtitle">오늘 과목별 학습시간</h3>
            <div id="study-today-summary" style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:20px">
              <p class="empty-text">오늘 기록이 없어요.</p>
            </div>
          </div>

          <div>
            <h3 class="section-subtitle">최근 기록</h3>
            <div class="study-log-list" id="study-log-list"><p class="empty-text">아직 기록이 없어요.</p></div>
          </div>
        </div>
      </div>

      <!-- 목표 -->
      <div class="tab-panel" id="tab-goals">
        <div class="study-container">
          <h2 class="study-section-title">목표 / D-Day</h2>
          <form id="goal-form" class="study-form-card" style="gap:12px">
            <div class="study-field">
              <label class="study-label">목표</label>
              <input type="text" id="goal-title" placeholder="목표 (예: 9월 모의고사)" required class="form-input" />
            </div>
            <div style="display:flex;gap:8px">
              <div class="study-field" style="flex:1">
                <label class="study-label">날짜</label>
                <input type="date" id="goal-date" required class="form-input" />
              </div>
              <div class="study-field" style="flex:1">
                <label class="study-label">분류 <span class="study-label-hint">선택</span></label>
                <input type="text" id="goal-category" placeholder="분류" class="form-input" />
              </div>
            </div>
            <button type="submit" class="btn-primary btn-full">목표 추가</button>
          </form>
          <div id="goal-list"><p class="empty-text">등록된 목표가 없어요.</p></div>
        </div>
      </div>
    </div>

    <datalist id="subject-list">
      <option value="국어"></option>
      <option value="영어"></option>
      <option value="수학"></option>
      <option value="과학"></option>
      <option value="사탐"></option>
      <option value="과탐"></option>
      <option value="기타"></option>
    </datalist>

    <script>
      import { planner } from '../lib/supabase';

      const SESSION_KEY = 'dcprime_planner_session';
      const ADMIN_SESSION_KEY = 'dcprime_planner_admin_session';

      type Session = { id: string; name: string; grade: string | null };

      function getSession(): Session | null {
        const raw = sessionStorage.getItem(SESSION_KEY);
        return raw ? JSON.parse(raw) : null;
      }

      function todayStr() {
        const d = new Date();
        return d.toISOString().slice(0, 10);
      }

      function weekStartStr() {
        const d = new Date();
        const day = d.getDay(); // 0=일
        const diff = day === 0 ? -6 : 1 - day; // 이번주 월요일
        d.setDate(d.getDate() + diff);
        return d.toISOString().slice(0, 10);
      }

      function escHtml(str: string) {
        return String(str ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
      }

      // ── PIN 로그인 (numpad + dots, dcprime.10 login.js 이식) ──
      const PIN_LENGTH = 4;
      let pin = '';
      let busy = false;
      const dots = Array.from({ length: PIN_LENGTH }, (_, i) => document.getElementById(`dot${i}`)!);
      const pinDisplay = document.getElementById('pin-display')!;
      const loginError = document.getElementById('login-error')!;
      const loginLoading = document.getElementById('login-loading')!;

      function updateDots() {
        dots.forEach((d, i) => {
          d.classList.toggle('filled', i < pin.length);
          d.classList.remove('error');
        });
      }

      function showLoginError(msg: string) {
        dots.forEach((d) => d.classList.add('error'));
        pinDisplay.classList.remove('shake');
        void pinDisplay.offsetWidth;
        pinDisplay.classList.add('shake');
        loginError.textContent = msg;
        loginError.classList.add('show');
        setTimeout(() => {
          pin = '';
          updateDots();
          loginError.classList.remove('show');
        }, 1400);
      }

      function showApp(session: Session) {
        document.getElementById('login-screen')!.classList.add('hidden');
        document.getElementById('app-screen')!.classList.remove('hidden');
        document.getElementById('student-name')!.textContent = session.name;
        document.getElementById('student-grade')!.textContent = session.grade ?? '';
        loadTodos();
        loadStudy();
        loadGoals();
      }

      function showLogin() {
        document.getElementById('login-screen')!.classList.remove('hidden');
        document.getElementById('app-screen')!.classList.add('hidden');
      }

      async function submitPin() {
        if (busy) return;
        busy = true;
        loginLoading.classList.add('show');
        const { data, error } = await planner.rpc('verify_pin', { p_pin: pin });
        if (!error && data && data.length > 0) {
          loginLoading.classList.remove('show');
          const student = data[0];
          const session: Session = { id: student.id, name: student.name, grade: student.grade };
          sessionStorage.setItem(SESSION_KEY, JSON.stringify(session));
          pin = '';
          updateDots();
          showApp(session);
          busy = false;
          return;
        }
        // 학생 PIN이 아니면 관리자 비밀번호로도 확인 (같은 로그인 화면에서 진입)
        const { data: isAdmin } = await planner.rpc('verify_admin_password', { pw: pin });
        loginLoading.classList.remove('show');
        if (isAdmin === true) {
          sessionStorage.setItem(ADMIN_SESSION_KEY, 'ok');
          location.href = '/admin';
          return;
        }
        showLoginError('PIN이 올바르지 않습니다.');
        busy = false;
      }

      function pressNum(n: string) {
        if (busy || pin.length >= PIN_LENGTH) return;
        pin += n;
        updateDots();
        if (navigator.vibrate) navigator.vibrate(10);
        if (pin.length === PIN_LENGTH) setTimeout(submitPin, 100);
      }

      function pressDelete() {
        if (busy || !pin.length) return;
        pin = pin.slice(0, -1);
        updateDots();
      }

      document.querySelectorAll('#login-screen .numpad-btn[data-num]').forEach((b) => {
        b.addEventListener('click', () => pressNum((b as HTMLElement).dataset.num!));
      });
      document.getElementById('delete-btn')?.addEventListener('click', pressDelete);
      document.addEventListener('keydown', (e) => {
        if (document.getElementById('login-screen')!.classList.contains('hidden')) return;
        if (e.key >= '0' && e.key <= '9') pressNum(e.key);
        else if (e.key === 'Backspace') pressDelete();
      });

      function doLogout() {
        sessionStorage.removeItem(SESSION_KEY);
        closeMenu();
        showLogin();
      }
      document.getElementById('logout-btn')?.addEventListener('click', doLogout);
      document.getElementById('hamburger-logout-btn')?.addEventListener('click', doLogout);

      // ── 탭 전환 + 모바일 드로어 메뉴 (dcprime.10 admin.js 이식) ──
      const tabBtns = document.querySelectorAll<HTMLElement>('.tab-btn');
      const panels: Record<string, HTMLElement> = {
        todos: document.getElementById('tab-todos')!,
        timetable: document.getElementById('tab-timetable')!,
        study: document.getElementById('tab-study')!,
        goals: document.getElementById('tab-goals')!,
      };
      const tabBar = document.querySelector('.tab-bar')!;
      const menuBackdrop = document.createElement('div');
      menuBackdrop.className = 'menu-backdrop';
      document.body.appendChild(menuBackdrop);
      const closeMenu = () => {
        tabBar.classList.remove('open');
        menuBackdrop.classList.remove('show');
      };
      const openMenu = () => {
        tabBar.classList.add('open');
        menuBackdrop.classList.add('show');
      };

      tabBtns.forEach((b) =>
        b.addEventListener('click', () => {
          const t = b.dataset.tab!;
          tabBtns.forEach((x) => x.classList.toggle('active', x.dataset.tab === t));
          Object.entries(panels).forEach(([k, p]) => p.classList.toggle('active', k === t));
          closeMenu();
          if (t === 'timetable') loadTimetable();
        })
      );
      document.getElementById('hamburger-btn')?.addEventListener('click', (e) => {
        e.stopPropagation();
        tabBar.classList.contains('open') ? closeMenu() : openMenu();
      });
      menuBackdrop.addEventListener('click', closeMenu);

      // ── 할일 ──
      async function loadTodos() {
        const session = getSession();
        if (!session) return;
        const { data: daily } = await planner
          .from('todos')
          .select('*')
          .eq('student_id', session.id)
          .eq('scope', 'daily')
          .eq('item_date', todayStr())
          .order('sort_order');
        renderTodoList('daily', daily ?? []);

        const { data: weekly } = await planner
          .from('todos')
          .select('*')
          .eq('student_id', session.id)
          .eq('scope', 'weekly')
          .eq('item_date', weekStartStr())
          .order('sort_order');
        renderTodoList('weekly', weekly ?? []);
      }

      function renderTodoList(scope: 'daily' | 'weekly', items: any[]) {
        const listEl = document.getElementById(`${scope}-todo-list`)!;
        const fillEl = document.getElementById(`${scope}-progress-fill`)!;
        const rateEl = document.getElementById(`${scope}-progress-rate`)!;
        const done = items.filter((t) => t.is_done).length;
        const rate = items.length ? Math.round((done / items.length) * 100) : 0;
        fillEl.style.width = `${rate}%`;
        rateEl.textContent = `${rate}%`;

        if (items.length === 0) {
          listEl.innerHTML = '<p class="empty-text">아직 등록된 항목이 없어요.</p>';
          return;
        }
        listEl.innerHTML = items
          .map(
            (t) => `
          <div class="gl-item">
            <div class="gl-check todo-check ${t.is_done ? 'done' : ''}" data-id="${t.id}">${t.is_done ? '✓' : ''}</div>
            <span class="gl-text ${t.is_done ? 'done' : ''}">
              ${t.subject ? `<span class="subject-badge" style="background:var(--blue-light);color:var(--blue);margin-right:6px">${escHtml(t.subject)}</span>` : ''}${escHtml(t.content)}
            </span>
            <button class="gl-del todo-delete" data-id="${t.id}">삭제</button>
          </div>`
          )
          .join('');
      }

      document.body.addEventListener('click', async (e) => {
        const target = e.target as HTMLElement;
        if (target.classList.contains('todo-check')) {
          const id = target.dataset.id!;
          const nowDone = !target.classList.contains('done');
          await planner.from('todos').update({ is_done: nowDone }).eq('id', id);
          loadTodos();
        }
        if (target.classList.contains('todo-delete')) {
          const id = target.dataset.id!;
          await planner.from('todos').delete().eq('id', id);
          loadTodos();
        }
        if (target.classList.contains('goal-delete')) {
          const id = target.dataset.id!;
          await planner.from('goals').delete().eq('id', id);
          loadGoals();
        }
      });

      document.getElementById('daily-todo-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const session = getSession();
        if (!session) return;
        const subject = (document.getElementById('daily-todo-subject') as HTMLInputElement).value.trim();
        const contentEl = document.getElementById('daily-todo-content') as HTMLInputElement;
        const content = contentEl.value.trim();
        if (!content) return;
        await planner.from('todos').insert({
          student_id: session.id,
          scope: 'daily',
          item_date: todayStr(),
          subject: subject || null,
          content,
        });
        contentEl.value = '';
        loadTodos();
      });

      document.getElementById('weekly-todo-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const session = getSession();
        if (!session) return;
        const subject = (document.getElementById('weekly-todo-subject') as HTMLInputElement).value.trim();
        const contentEl = document.getElementById('weekly-todo-content') as HTMLInputElement;
        const content = contentEl.value.trim();
        if (!content) return;
        await planner.from('todos').insert({
          student_id: session.id,
          scope: 'weekly',
          item_date: weekStartStr(),
          subject: subject || null,
          content,
        });
        contentEl.value = '';
        loadTodos();
      });

      // ── 시간표 (텐투텐 일일 스케쥴 이식) ──
      const TT_SUBJECTS = [
        { key: '스카', color: '#0064FF' },
        { key: '식사', color: '#F59E0B' },
        { key: '학원수업', color: '#00B493' },
        { key: '기타', color: '#8B5CF6' },
        { key: '지우개', color: '#D1D6DB', erase: true },
      ];
      // 08:00 ~ 24:00, 30분 단위 (32칸)
      const TT_SLOTS: string[] = [];
      for (let m = 480; m < 1440; m += 30) {
        const h = Math.floor(m / 60), mm = m % 60;
        TT_SLOTS.push(`${String(h).padStart(2, '0')}:${String(mm).padStart(2, '0')}`);
      }

      let ttSel = '스카';
      let ttRow: { slots: Record<string, string>; submitted: boolean } = { slots: {}, submitted: false };
      let ttInited = false;

      function ttYmd(d: Date) {
        return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
      }
      const TT_TODAY = ttYmd(new Date());
      const ttBaseKey = (k: string) => (k ? k.split(':')[0] : k);
      const ttColorOf = (k: string) => (TT_SUBJECTS.find((s) => s.key === ttBaseKey(k)) || {}).color || '#fff';
      const ttDisplayOf = (k: string) => {
        if (!k) return '';
        const [base, ...rest] = k.split(':');
        return rest.length ? `${base}(${rest.join(':')})` : base;
      };

      async function ttLoadDay(studentId: string) {
        const { data } = await planner.from('timetables').select('*').eq('student_id', studentId).eq('date', TT_TODAY).maybeSingle();
        if (data) ttRow = { slots: data.slots || {}, submitted: !!data.submitted };
      }

      async function ttPersist(studentId: string, extra?: Record<string, unknown>) {
        const payload = { student_id: studentId, date: TT_TODAY, slots: ttRow.slots, submitted: ttRow.submitted, ...(extra || {}) };
        const { error } = await planner.from('timetables').upsert(payload, { onConflict: 'student_id,date' });
        if (error) console.error('시간표 저장 오류', error);
      }

      function ttRenderLegend() {
        const legend = document.getElementById('tt-legend')!;
        legend.innerHTML = TT_SUBJECTS.map(
          (s) => `<button type="button" class="tt-sub ${s.key === ttSel ? 'sel' : ''}" data-sub="${s.key}">
             <span class="dot" style="background:${s.color}"></span>${s.key}
           </button>`
        ).join('');
        legend.querySelectorAll('.tt-sub').forEach((b) =>
          b.addEventListener('click', () => {
            ttSel = (b as HTMLElement).dataset.sub!;
            ttRenderLegend();
          })
        );
      }

      function ttRenderSubmitState() {
        const submitBtn = document.getElementById('tt-submit')!;
        if (ttRow.submitted) {
          submitBtn.textContent = '제출 완료 ✓ (다시 제출하기)';
          submitBtn.classList.add('done');
        } else {
          submitBtn.textContent = '오늘 시간표 제출';
          submitBtn.classList.remove('done');
        }
      }

      function ttRenderSummary() {
        const summaryEl = document.getElementById('tt-summary')!;
        const studied = Object.keys(ttRow.slots).length;
        const totalH = (studied * 0.5).toFixed(1);
        const bySub: Record<string, number> = {};
        Object.values(ttRow.slots).forEach((s) => {
          const k = ttBaseKey(s);
          bySub[k] = (bySub[k] ?? 0) + 0.5;
        });
        const parts = Object.entries(bySub)
          .map(([k, h]) => `<span class="tt-stat"><span class="dot" style="display:inline-block;width:9px;height:9px;border-radius:50%;background:${ttColorOf(k)};margin-right:5px"></span>${k} <b>${h}h</b></span>`)
          .join('');
        summaryEl.innerHTML = `<span class="tt-stat">총 공부 <b>${totalH}시간</b></span><span class="tt-stat">빈 시간 <b>${(TT_SLOTS.length - studied) * 0.5}시간</b></span>${parts}`;
      }

      function ttRenderGrid(studentId: string) {
        const grid = document.getElementById('tt-grid')!;
        grid.innerHTML = TT_SLOTS.map((t) => {
          const v = ttRow.slots[t];
          const style = v ? `background:${ttColorOf(v)}` : '';
          const label = v ? ttDisplayOf(v) : '';
          return `<div class="tt-row">
            <div class="tt-time">${t}</div>
            <div class="tt-cell ${v ? '' : 'empty'}" data-slot="${t}" style="${style}">${label}</div>
          </div>`;
        }).join('');
        grid.querySelectorAll('.tt-cell').forEach((c) =>
          c.addEventListener('click', () => {
            const slot = (c as HTMLElement).dataset.slot!;
            if (ttSel === '지우개') {
              delete ttRow.slots[slot];
            } else if (ttSel === '기타') {
              const reason = window.prompt('기타 사유를 입력해주세요 (선택사항)', '');
              if (reason === null) return;
              ttRow.slots[slot] = reason.trim() ? `기타:${reason.trim()}` : '기타';
            } else {
              if (ttSel === '식사') {
                const mealCount = Object.entries(ttRow.slots).filter(([k, v]) => k !== slot && ttBaseKey(v) === '식사').length;
                if (mealCount >= 4) {
                  alert('식사시간은 점심 저녁 도합 2시간입니다.');
                  return;
                }
              }
              ttRow.slots[slot] = ttSel;
            }
            ttRenderGrid(studentId);
            ttRenderSummary();
            ttPersist(studentId);
          })
        );
        ttRenderSummary();
      }

      async function loadTimetable() {
        const session = getSession();
        if (!session) return;

        const dateEl = document.getElementById('tt-date')!;
        dateEl.textContent = `${TT_TODAY} (${['일', '월', '화', '수', '목', '금', '토'][new Date().getDay()]}) · 오늘`;

        if (!ttInited) {
          ttInited = true;
          document.getElementById('tt-submit')?.addEventListener('click', async () => {
            ttRow.submitted = true;
            await ttPersist(session.id, { submitted_at: new Date().toISOString() });
            ttRenderSubmitState();
            alert('오늘 시간표가 제출되었습니다.');
          });

          // 자정에 새로고침 → 시간표 초기화 (텐투텐과 동일)
          const msUntilMidnight = () => {
            const n = new Date();
            const m = new Date(n);
            m.setHours(24, 0, 0, 0);
            return m.getTime() - n.getTime();
          };
          setTimeout(() => location.reload(), msUntilMidnight());
        }

        await ttLoadDay(session.id);
        ttRenderLegend();
        ttRenderSubmitState();
        ttRenderGrid(session.id);
      }

      // ── 학습시간 ──
      async function loadStudy() {
        const session = getSession();
        if (!session) return;

        const { data: todayLogs } = await planner
          .from('study_logs')
          .select('subject, minutes')
          .eq('student_id', session.id)
          .eq('log_date', todayStr());
        const bySubject: Record<string, number> = {};
        (todayLogs ?? []).forEach((l: any) => {
          const key = l.subject || '기타';
          bySubject[key] = (bySubject[key] ?? 0) + l.minutes;
        });
        const summaryEl = document.getElementById('study-today-summary')!;
        const entries = Object.entries(bySubject);
        summaryEl.innerHTML = entries.length
          ? entries.map(([subj, min]) => `<span class="subject-badge" style="background:var(--blue-light);color:var(--blue)">${escHtml(subj)} ${min}분</span>`).join('')
          : '<p class="empty-text">오늘 기록이 없어요.</p>';

        const { data: recent } = await planner
          .from('study_logs')
          .select('*')
          .eq('student_id', session.id)
          .order('log_date', { ascending: false })
          .order('created_at', { ascending: false })
          .limit(10);
        const listEl = document.getElementById('study-log-list')!;
        listEl.innerHTML = (recent ?? []).length
          ? recent!
              .map(
                (l: any) => `
            <div class="study-log-item">
              <div class="study-log-info">
                <div class="study-log-top">
                  <span class="subject-badge" style="background:var(--blue-light);color:var(--blue)">${l.subject ? escHtml(l.subject) : '기타'}</span>
                  <span class="study-log-hours">${l.minutes}분</span>
                </div>
                ${l.memo ? `<p class="study-log-summary">${escHtml(l.memo)}</p>` : ''}
                <p class="study-log-date">${l.log_date}</p>
              </div>
            </div>`
              )
              .join('')
          : '<p class="empty-text">아직 기록이 없어요.</p>';
      }

      document.getElementById('study-log-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const session = getSession();
        if (!session) return;
        const date = (document.getElementById('study-log-date') as HTMLInputElement).value;
        const subject = (document.getElementById('study-log-subject') as HTMLInputElement).value.trim();
        const minutesEl = document.getElementById('study-log-minutes') as HTMLInputElement;
        const memoEl = document.getElementById('study-log-memo') as HTMLInputElement;
        const minutes = parseInt(minutesEl.value, 10);
        if (!date || !minutes) return;
        await planner.from('study_logs').insert({
          student_id: session.id,
          log_date: date,
          subject: subject || null,
          minutes,
          memo: memoEl.value.trim() || null,
        });
        minutesEl.value = '';
        memoEl.value = '';
        loadStudy();
      });

      // ── 목표 ──
      function dDayLabel(targetDate: string) {
        const today = new Date(todayStr());
        const target = new Date(targetDate);
        const diff = Math.round((target.getTime() - today.getTime()) / 86400000);
        if (diff === 0) return 'D-DAY';
        return diff > 0 ? `D-${diff}` : `D+${Math.abs(diff)}`;
      }

      async function loadGoals() {
        const session = getSession();
        if (!session) return;
        const { data } = await planner
          .from('goals')
          .select('*')
          .eq('student_id', session.id)
          .eq('is_active', true)
          .order('target_date', { ascending: true });
        const el = document.getElementById('goal-list')!;
        el.innerHTML = (data ?? []).length
          ? data!
              .map(
                (g: any) => `
            <div class="dday-card">
              <span class="dday-badge">${dDayLabel(g.target_date)}</span>
              <div style="flex:1">
                <p class="dday-title">${escHtml(g.title)}</p>
                <p class="dday-meta">${g.target_date}${g.category ? ` · ${escHtml(g.category)}` : ''}</p>
              </div>
              <button data-id="${g.id}" class="gl-del goal-delete">삭제</button>
            </div>`
              )
              .join('')
          : '<p class="empty-text">등록된 목표가 없어요.</p>';
      }

      document.getElementById('goal-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const session = getSession();
        if (!session) return;
        const titleEl = document.getElementById('goal-title') as HTMLInputElement;
        const dateEl = document.getElementById('goal-date') as HTMLInputElement;
        const categoryEl = document.getElementById('goal-category') as HTMLInputElement;
        if (!titleEl.value.trim() || !dateEl.value) return;
        await planner.from('goals').insert({
          student_id: session.id,
          title: titleEl.value.trim(),
          target_date: dateEl.value,
          category: categoryEl.value.trim() || null,
        });
        titleEl.value = '';
        dateEl.value = '';
        categoryEl.value = '';
        loadGoals();
      });

      // ── 초기화 ──
      (document.getElementById('study-log-date') as HTMLInputElement).value = todayStr();
      if (sessionStorage.getItem(ADMIN_SESSION_KEY) === 'ok') {
        location.replace('/admin');
      } else {
        const existing = getSession();
        if (existing) showApp(existing);
      }
    </script>
  </body>
</html>
